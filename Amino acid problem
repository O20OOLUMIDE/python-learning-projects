textfile.close()

# subroutine that reads DNA sequence
def code_sequence():
    filename = input("Enter name of file the DNA sequences are on: ")
    textfile = open(filename, "r")
    DNA = textfile.read().strip()
    textfile.close()

    codons = []

    for i in range(0, len(DNA) - 2, 3):
        group = DNA[i:i+3]
        codons.append(group)

    search = input("Enter the 3-letter amino acid sequence to search for: ")
    count = codons.count(search)

    return count

# Main program
result = code_sequence()

print("Number of times the amino acid appears:", result)
